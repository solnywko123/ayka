# === Общие ===
# dev — предупреждения о плейсхолдерах в конфиге, prod — сборка прерывается, если плейсхолдеры не заменены
BUILD_ENV=dev

# === API / FastAPI ===
# Относительный путь резолвится от рабочей директории процесса — команды запускаются из api/
# (см. README): sqlite:///./dev.db для локальной разработки.
# postgresql+psycopg://user:password@host:5432/dbname в проде
DATABASE_URL=sqlite:///./dev.db

# Путь к единому файлу цен (по умолчанию site/content/pricing.json)
PRICING_PATH=site/content/pricing.json

# Секрет для подписи JWT админки. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Логин администратора
ADMIN_USERNAME=admin
# bcrypt-хеш пароля администратора. Сгенерировать: make hash-password
ADMIN_PASSWORD_HASH=

# Соль для хеширования IP-адресов (SHA-256), персональные данные не хранить в открытом виде
IP_HASH_SALT=change-me-to-a-random-string

# Домен фронтенда, разрешённый в CORS (без слеша в конце)
CORS_ORIGIN=https://example.kg

# === Telegram (опционально, выключено по умолчанию) ===
# Если оставить пустым — уведомления о заявках в Telegram отправляться не будут
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Rate limiting ===
RATE_LIMIT_LEADS_PER_HOUR=5
RATE_LIMIT_QUOTE_PER_MINUTE=30
